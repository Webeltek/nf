{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "ES2022",
    "importHelpers": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "paths": {
      "angular-calendar": [
        "./projects/angular-calendar/src"
      ],
      "angular-calendar/date-adapters/date-fns": [
        "./projects/angular-calendar/src/date-adapters/date-fns"
      ],
      "angular-calendar/date-adapters/moment": [
        "./projects/angular-calendar/src/date-adapters/moment"
      ],
      "my-lib": [
        "dist/my-lib/my-lib",
        "dist/my-lib",
        "dist/my-lib/my-lib",
        "dist/my-lib",
        "dist/my-lib/my-lib",
        "dist/my-lib",
        "dist/my-lib/my-lib",
        "dist/my-lib",
        "dist/my-lib/my-lib",
        "dist/my-lib"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true
  }
}
